# 复制成 .env 再填。.env 已在 .gitignore 里，不要提交。

# 直连官方：https://api.anthropic.com
# 中转站：填站方给的地址，只到域名（或站方说明的前缀），不要带 /v1/messages
API_BASE=https://api.anthropic.com

API_KEY=

# 先跑 examples/curl/01-models.sh，从返回的列表里抄，不要凭印象写
MODEL=

# 可选。不填时：官方域名用 x-api-key，其他地址用 bearer（guide §1.1.1）
# AUTH_STYLE=x-api-key
# AUTH_STYLE=bearer

# 可选。中转站只兼容旧版时改成 2023-06-01
# API_VERSION=2026-10-21
